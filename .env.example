# Copy to .env and fill in. Everything is optional: with no keys the app runs on the
# built-in mock interviewer so you can try the whole flow offline.

HOST=127.0.0.1
PORT=8920

# AI providers, tried in order; the first one that is configured and succeeds wins.
# Options: gemini, groq, claude-cli, mock
LLM_PROVIDERS=groq

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free key: https://console.groq.com/keys (also enables Whisper transcription)
GROQ_API_KEY=
# Model chain, tried in order (limits are per model). GROQ_MODEL=<one model> also works.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# gpt-oss reasoning effort: low | medium | high (low saves tokens)
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3-turbo

# Experimental, laptop only: uses your local `claude` CLI (counts against your plan's limits).
CLAUDE_BIN=claude
CLAUDE_MODEL=

# Auth: none (local only) | token | cloudflare | cloudflare,token
AUTH_MODE=none
ACCESS_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Admins: always allowed, see the Admin page, no daily AI limit. The first one also
# owns interviews created before multi-user support.
ADMIN_EMAILS=you@example.com
# Optional: emails to invite at startup (you can also invite from the Admin page).
ALLOWED_EMAILS=

AI_RATE_LIMIT_PER_MIN=20
# AI requests per user per day (admins unlimited; override per user in the Admin page)
DAILY_AI_LIMIT=60
# Exit after this many idle minutes (0 = never). Used for on-demand hosting on Nexus.
IDLE_SHUTDOWN_MINUTES=0
