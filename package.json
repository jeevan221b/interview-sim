{
  "name": "interview-sim",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w web"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
